# ==============================================================================
# ResilienceMesh Root .gitignore
# ==============================================================================

# Local Tooling & Downloaded SDKs
/flutter/
/jdk-*/
/android-sdk/

# Environment & System Caches
/.android/
/.cache/
/.config/
/.dart-tool/
/.dartServer/
/.flutter
/.gradle/
/.local/
/.pub-cache/

# Mobile App Build Outputs & Caches
/mobile/build/
/mobile/android/build/
/mobile/android/.gradle/
/mobile/android/.idea/
/mobile/.dart_tool/
/mobile/.flutter-plugins
/mobile/.flutter-plugins-dependencies
/mobile/.metadata
/mobile/*.iml

# Large Model Files & Binaries (Keep tokenizer.model)
*.litertlm
*.bin
*.task
*.tflite
!mobile/assets/models/tokenizer.model

# Unused Non-Android Platform Templates
/mobile/ios/
/mobile/linux/
/mobile/macos/
/mobile/web/
/mobile/windows/

# Node.js Dependencies & Caches (Keep dist/ for zero-dependency python execution)
/backend/frontend/node_modules/
/backend/frontend/.vite/
/backend/frontend/npm-debug.log*
/backend/frontend/yarn-debug.log*
/backend/frontend/yarn-error.log*
/backend/frontend/pnpm-debug.log*

# IDE & Editor Files
.idea/
.vscode/
*.iml
*.swp
*.swo
.DS_Store

# Python & Backend Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
env/
venv/
backend/data/vector_db/
backend/.env

# OS & Environment Files
.env
*.log
